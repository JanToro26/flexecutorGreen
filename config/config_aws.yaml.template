# AWS Lambda + S3 backend.
#
# Copy to config/config_aws.yaml (gitignored) and fill in the placeholders.
# AWS Academy session tokens expire after a few hours.
#
#   LITHOPS_CONFIG_FILE=config/config_aws.yaml python examples/energy_apps/run.py profile
#
# RAPL and perf are unavailable on Lambda, so energy comes from the psutil
# power model only. Check worker_func_psutil_cpu_tdp_is_default in the stats:
# if True, the TDP was not resolved and the absolute joules are unreliable.

lithops:
    backend: aws_lambda
    storage: aws_s3
    data_cleaner: True
    execution_timeout: 300
    log_level: INFO
    runtime_version_tolerance: 1

aws:
    AWS_ACCESS_KEY_ID: "YOUR_ACCESS_KEY_ID"
    AWS_SECRET_ACCESS_KEY: "YOUR_SECRET_ACCESS_KEY"
    AWS_SESSION_TOKEN: "YOUR_SESSION_TOKEN"
    region: us-east-1

aws_lambda:
    execution_role: arn:aws:iam::YOUR_ACCOUNT_ID:role/lambdaLithopsExecutionRole
    runtime_timeout: 300

    # Lambda allocates CPU in proportion to memory, so this is the CPU knob too.
    # Sweep with --memory 512 1024 2048.
    runtime_memory: 1024

    architecture: x86_64
    # architecture: arm64

    # Leave runtime unset to let Lithops build a default one. The apps need
    # only numpy and scikit-learn.
    # runtime: YOUR_RUNTIME_NAME

    max_workers: 1000
    worker_processes: 1
    invoke_pool_threads: 64
    ephemeral_storage: 512

aws_s3:
    storage_bucket: YOUR_S3_BUCKET_NAME
    region: us-east-1
